<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Required since Android 11's package visibility changes - without this,
         PackageManager.queryIntentActivities(ACTION_MAIN/CATEGORY_LAUNCHER) (used by
         AppAllowlistScreen to list installed apps) silently returns a filtered subset
         instead of every launchable app. Found live 2026-08-15: games and other less
         "default visible" apps were missing from the Shared Apps list because of this. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher_cyber"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:enableOnBackInvokedCallback="true">

        <!-- One app, both roles - a role picker decides at launch whether this session
             acts as controller (views/controls a paired device) or controllee (lets a
             paired device view/control this one). Deliberately NOT
             android.intent.category.HOME and no Device Admin receiver of any kind
             either way - just an ordinary app someone opens, uses, and can fully leave
             via logout/uninstall at any time.

             No MAIN/LAUNCHER intent-filter here on purpose - the three activity-alias
             entries below are the only way in, so exactly one app icon ever shows
             (whichever alias is currently enabled). Adding one back here would put a
             4th, un-switchable icon in the launcher alongside them. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/app_name" />

        <!-- Appearance > app icon (Settings screen) - Android has no API to swap a
             launcher icon at runtime by itself; toggling which of these three is
             enabled via PackageManager (see AppIconSwitcher.kt) is the standard
             mechanism. Cyber ships enabled by default - it matches every other
             screen's look already. Exactly one of the three must be enabled at a
             time; AppIconSwitcher.switchTo() is the only thing that should ever
             change these. -->
        <activity-alias
            android:name=".IconCyber"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/ic_launcher_cyber"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconGlassy"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_glassy"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconHazy"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_hazy"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Controllee role only - see com.example.phonelinkagent.PhoneLinkAccessibilityService. -->
        <service
            android:name="com.example.phonelinkagent.PhoneLinkAccessibilityService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/phone_link_accessibility_service_config" />
        </service>

        <!-- stopWithTask="false": without this, swiping the app away from Recents kills the
             capture/control session outright, even though it's a real foreground service -
             found live 2026-08-10. The whole point of the controllee role is running
             unattended while the owner isn't actively looking at it. -->
        <service
            android:name="com.example.phonelinkagent.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection"
            android:stopWithTask="false" />

    </application>
</manifest>
